# Copy to .env and edit. Never commit the real .env.
APP_ENV=development
SECRET_KEY=change-this-in-production
JWT_SECRET_KEY=change-this-too
CORS_ORIGINS=http://localhost:5173

# Optional: only these email domains may register (comma separated). Empty = any email.
ALLOWED_EMAIL_DOMAINS=
# Optional: these accounts can open /admin to moderate reports.
ADMIN_EMAILS=

# Optional: use PostgreSQL instead of the local SQLite file.
# DATABASE_URL=postgresql://user:password@localhost:5432/hostelhub
